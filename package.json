{
  "name": "opencode-openai-images",
  "version": "0.1.0",
  "description": "OpenCode tools for OpenAI Images-compatible generation and editing",
  "license": "MIT",
  "author": {
    "name": "lih54767-coder",
    "url": "https://github.com/lih54767-coder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lih54767-coder/opencode-openai-images.git"
  },
  "bugs": {
    "url": "https://github.com/lih54767-coder/opencode-openai-images/issues"
  },
  "homepage": "https://github.com/lih54767-coder/opencode-openai-images#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openai-compatible",
    "images",
    "image-generation",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0",
    "opencode": ">=1.18.4 <2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.4 <2"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "node scripts/clean.mjs",
    "check:package": "node scripts/check-package.mjs",
    "smoke:plugin": "npm run build && node scripts/smoke-plugin.mjs",
    "smoke:opencode": "npm run build && node scripts/smoke-opencode.mjs",
    "smoke:runtime": "npm run build && node scripts/smoke-opencode-runtime.mjs",
    "smoke": "npm run smoke:plugin && npm run smoke:opencode",
    "verify": "npm run typecheck && npm run build && npm test && npm run check:package && npm run smoke:plugin",
    "prepublishOnly": "npm run verify"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.4",
    "@types/node": "^26.1.2",
    "typescript": "^5.8.3"
  }
}
